{
    "name": "suifuda/suifuda-open-sdk",
    "description": "随付达开放平台 PHP SDK",
    "version": "2.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "张丹峰"
        }
    ],
    "require": {
        "php": ">=7.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-gmp": "*",
        "lpilp/guomi": "^1.0",
        "fgrosse/phpasn1": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Suifuda\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Suifuda\\Sdk\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.5"
    },
    "minimum-stability": "stable"
}
